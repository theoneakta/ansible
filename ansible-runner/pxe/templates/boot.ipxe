#!ipxe
# Boot menu, served over HTTP by the pxe container (rendered at start-up:
# only $PXE_* variables are substituted, everything else is iPXE syntax).
set base http://${PXE_SERVER_IP}:${PXE_HTTP_PORT}

# Per-machine override first: image_capture.yml drops hosts/<mac>.ipxe for
# the Proxmox clone it's capturing, so that clone boots straight into
# capture mode with no menu. A 404 here is normal for every other machine.
chain --autofree ${base}/hosts/${mac:hexhyp}.ipxe ||

iseq ${platform} efi || goto bios

:menu
menu PXE - ${PXE_SERVER_IP}
item local   Boot from local disk
item --gap
#@MENU_ITEMS@
item --gap
item shell   iPXE shell
choose --default local --timeout 20000 target || goto local
goto ${target}

#@DEPLOY_TARGETS@

:winpe
# winpe/build/<action>.wim: plain WinPE with the action's script baked in as
# startnet.cmd - built by the pxe container (see entrypoint.sh).
# -n sets the name wimboot exposes: the ISO's BCD loads \boot.wim, and with
# any other name the boot manager stops with 0xc000000f (confirmed live). A
# trailing word after the URL is NOT a name - it's a command-line argument.
kernel ${base}/wimboot
initrd -n bootmgfw.efi ${base}/winpe/build/bootmgfw.efi
initrd -n BCD          ${base}/winpe/boot/bcd
initrd -n boot.sdi     ${base}/winpe/boot/boot.sdi
initrd -n boot.wim     ${base}/winpe/build/${action}.wim
boot || goto failed

:failed
echo Boot failed. Are the WinPE files extracted (run "Capture" once from the GUI)?
prompt Press any key for the menu... ||
goto menu

:local
exit

:shell
shell

:bios
echo Windows 11 deployment needs UEFI boot - switch this PC's firmware to UEFI mode.
sleep 10
exit
