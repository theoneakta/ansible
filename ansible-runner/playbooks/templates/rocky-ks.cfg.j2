{# Kickstart for {{ img.label }}, rendered by Ansible in two modes:
   ks_mode=build  - image_build.yml, fed to Packer on an OEMDRV-labelled CD
                    (Anaconda picks that up automatically) to build the
                    Proxmox template;
   ks_mode=deploy - image_publish_linux.yml, served over HTTP by the pxe
                    container for "Deploy Rocky Linux" network installs.
   Same packages and accounts either way, so a PXE-installed machine matches
   the template. #}
# {{ img.label }} kickstart ({{ ks_mode }}) - generated by ansible-runner, do not edit
text
lang {{ image_locale | replace('-', '_') }}.UTF-8
keyboard us
timezone {{ image_linux_timezone }} --utc
network --bootproto=dhcp --activate --onboot=yes
rootpw --lock
user --name={{ image_admin_user }} --groups=wheel --password={{ image_admin_password | password_hash('sha512') }} --iscrypted
selinux --enforcing
firewall --enabled --service=ssh
services --enabled=sshd
firstboot --disable
bootloader --timeout=1
{% if ks_mode == 'build' %}
zerombr
clearpart --all --initlabel
autopart --type=lvm --nohome
{% else %}
# The first non-removable, writable disk only - like the Windows entries'
# "disk 0". Other disks are left alone.
%include /tmp/disk.ks
{% endif %}
reboot

%packages --ignoremissing
@^minimal-environment
openssh-server
sudo
python3
curl
tar
%end
{% if ks_mode == 'deploy' %}

%pre --log=/tmp/ks-pre.log
disk=$(lsblk -dnpo NAME,TYPE,RM,RO | awk '$2=="disk" && $3=="0" && $4=="0" {print $1; exit}')
d=${disk#/dev/}
cat > /tmp/disk.ks <<EOF
ignoredisk --only-use=$d
zerombr
clearpart --all --initlabel --drives=$d
autopart --type=lvm --nohome
EOF
%end
{% endif %}

%post --log=/root/ks-post.log
{% if ks_mode == 'build' %}
# Proxmox template extras. Not in %packages: the minimal ISO doesn't carry
# them (and --ignoremissing skipped them silently), so install from the
# online repos - the VM is on the network by now. Not in `services
# --enabled` either: qemu-guest-agent has no [Install] section - it starts
# by itself when Proxmox's agent channel exists - and enabling it there
# aborted the install ("Error enabling service qemu-guest-agent") - confirmed
# live. Packer finds the VM's IP through that agent.
dnf -y install qemu-guest-agent cloud-init

# Packer's provisioner needs passwordless sudo; removed again by its last step.
echo '{{ image_admin_user }} ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/99-packer-build
chmod 440 /etc/sudoers.d/99-packer-build
{% endif %}
%end
