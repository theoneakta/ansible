{# Ubuntu Server autoinstall (Subiquity) for {{ img.label }}, the Ubuntu
   counterpart of rocky-ks.cfg.j2, rendered by Ansible in two modes:
   ks_mode=build  - image_build.yml: user-data on a "cidata" CD that the
                    installer reads by itself, to build the Proxmox template;
   ks_mode=deploy - image_publish_linux.yml: served over HTTP by the pxe
                    container (ds=nocloud;s=.../ks/<id>/) for "Deploy Ubuntu"
                    network installs.
   Same packages and accounts either way, so a PXE-installed machine matches
   the template. #}
#cloud-config
# {{ img.label }} autoinstall ({{ ks_mode }}) - generated by ansible-runner, do not edit
autoinstall:
  version: 1
  locale: {{ image_locale | replace('-', '_') }}.UTF-8
  keyboard:
    layout: us
  timezone: {{ image_linux_timezone }}
  # IPv6 off everywhere: no IPv6 on the interface here, and disabled in the
  # kernel itself (ipv6.disable=1, late-commands below).
  network:
    version: 2
{% if img.desktop | default(false) %}
    # The desktop manages networking with NetworkManager (Settings, tray).
    renderer: NetworkManager
{% endif %}
    ethernets:
      wired:
        match:
          name: "e*"
        dhcp4: true
        dhcp6: false
        accept-ra: false
        link-local: []
  # LVM over the whole disk. With several disks the installer picks the
  # largest one (its default) - deploy erases that disk.
  storage:
    layout:
      name: lvm
      sizing-policy: all
  identity:
    hostname: ubuntu
    username: {{ image_admin_user }}
    password: "{{ image_admin_password | password_hash('sha512') }}"
  ssh:
    install-server: true
    allow-pw: true
  # Install every pending update from the archive, not just security fixes,
  # so a new machine starts current rather than at the ISO's point release.
  updates: all
  packages:
    - python3
    - curl
{% if img.desktop | default(false) %}
    # Desktop variant: the full Ubuntu Desktop (GNOME and its standard apps)
    # on top of the server install - same installer, same answers.
    - ubuntu-desktop
{% endif %}
{% if ks_mode == 'build' %}
    # Packer finds the VM's IP through the guest agent.
    - qemu-guest-agent
{% endif %}
  # Each command is a literal block (|-), never a plain YAML string: the
  # sudoers line's "NOPASSWD: ALL" made it a mapping and the installer
  # stopped with "Malformed autoinstall in 'late-commands'" (confirmed live).
  late-commands:
    - |-
      sed -i 's/^GRUB_CMDLINE_LINUX="/GRUB_CMDLINE_LINUX="ipv6.disable=1 /' /target/etc/default/grub
    - |-
      curtin in-target --target=/target -- update-grub
{% if ks_mode == 'build' %}
    # Packer's provisioner needs passwordless sudo; removed again by its last step.
    - |-
      echo '{{ image_admin_user }} ALL=(ALL) NOPASSWD: ALL' > /target/etc/sudoers.d/99-packer-build
    - |-
      chmod 440 /target/etc/sudoers.d/99-packer-build
{% else %}
    # PXE installs onto a Proxmox VM get the guest agent too, so Proxmox shows
    # the IP and can shut it down cleanly. Physical machines don't need it.
    - |-
      if [ "$(systemd-detect-virt)" = kvm ]; then curtin in-target --target=/target -- apt-get install -y qemu-guest-agent; fi
{% endif %}
  shutdown: reboot
